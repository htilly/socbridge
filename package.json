{
  "name": "socbridge",
  "version": "0.1.0",
  "description": "MCP server that fronts a security tooling stack (Wazuh, Trivy, DefectDojo, Graylog) behind a single authenticated HTTPS endpoint.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec dist/test/*.test.js",
    "fonts:update": "node scripts/update-fonts.mjs",
    "test:e2e": "scripts/e2e/run.sh"
  },
  "files": [
    "dist",
    "public"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simplewebauthn/server": "^14.0.0",
    "acme-client": "^5.4.0",
    "express": "^5.3.0",
    "mmdb-lib": "^3.0.5",
    "node-forge": "^1.4.3",
    "undici": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/node-forge": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
