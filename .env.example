# --- Required -------------------------------------------------------------

# Public HTTPS origin clients and browsers use. Must be https and a hostname
# (passkeys do not work on IP addresses). No path.
PUBLIC_URL=https://socbridge.example.com

# 32-byte key that encrypts the config at rest. Generate with:
#   openssl rand -hex 32
# Prefer CONFIG_ENCRYPTION_KEY_FILE (e.g. a Docker secret) in production.
CONFIG_ENCRYPTION_KEY=
# CONFIG_ENCRYPTION_KEY_FILE=/run/secrets/socbridge_config_key

# Earlier keys, comma separated, while changing the key (or _FILE). Keep them
# as long as audit records written with them should stay readable.
# CONFIG_ENCRYPTION_KEY_PREVIOUS=
# 2 = separate derived key per kind of data. Versions before it cannot read the
# result, so set it only once you will not roll back past this version.
# ENCRYPTION_FORMAT=1

# --- Transport ------------------------------------------------------------

# true: refuse plain http and unverified TLS to backends and the GELF input.
# REQUIRE_SECURE_TRANSPORT=false

# --- TLS ------------------------------------------------------------------

# builtin: self-managed offline CA issues and renews the server certificate
# file:    use TLS_CERT_FILE / TLS_KEY_FILE (reloaded when they change)
# acme:    Let's Encrypt via DNS-01 on Cloudflare (works for internal-only names)
# off:     plain HTTP, for running behind a reverse proxy that terminates TLS
TLS_MODE=builtin
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem
# TLS_MODE=acme:
# ACME_AGREE_TOS=true                 # required: accept the CA's subscriber agreement
# ACME_EMAIL=ops@example.com          # optional expiry/contact address
# ACME_STAGING=false                  # true = Let's Encrypt staging (untrusted test certs)
# CLOUDFLARE_DNS_API_TOKEN_FILE=/run/secrets/cloudflare_dns_token   # Zone:Read + DNS:Edit
# ACME_DNS_RESOLVERS=1.1.1.1,8.8.8.8  # public resolvers used to confirm the TXT record
# Extra names/IPs for the certificate, comma separated (IPs only with builtin).
# TLS_EXTRA_SANS=socbridge.internal.example.com,192.0.2.10

# --- Listener -------------------------------------------------------------

# PORT=8443            # default 8443, or 8080 when TLS_MODE=off
# HOST=0.0.0.0
# DATA_DIR=/data

# City database (MaxMind .mmdb format) that places firewall sources on the map.
# GEOIP_DB=/data/geoip.mmdb

# Behind a reverse proxy, set so client IPs (rate limiting, logs) are correct:
# "loopback", a hop count like "1", or a comma-separated list of subnets.
# TRUST_PROXY=loopback

# --- OAuth (Claude custom connectors) -------------------------------------

# Hosts OAuth clients may register as https redirect URIs. Loopback http
# (http://localhost:…) is always allowed for local clients. "*" allows any.
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com

# --- First admin ----------------------------------------------------------

# Optional fixed one-time token for enrolling the first admin (>= 24 chars).
# If unset, a random one is printed in the log at startup until an admin exists.
# SETUP_TOKEN=

# LOG_LEVEL=info
